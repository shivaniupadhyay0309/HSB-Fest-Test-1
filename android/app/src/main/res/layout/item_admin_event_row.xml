<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <!-- Event Title & Icon -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.2"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvAdminEventIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💻"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAdminEventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="HackZenith 24hr Hackathon"
                android:textColor="@color/slate_900"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAdminEventVenue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tech Hub Lab 3 • Nov 14"
                android:textColor="@color/slate_500"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Category Badge -->
    <TextView
        android:id="@+id/tvAdminEventCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_badge_default"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="Technical"
        android:textColor="@color/badge_technical_text"
        android:textSize="10sp"
        android:textStyle="bold" />

    <!-- Registered / Capacity -->
    <TextView
        android:id="@+id/tvAdminEventRatio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.1"
        android:gravity="center"
        android:text="0 / 100"
        android:textColor="@color/slate_700"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Utilization % Badge -->
    <TextView
        android:id="@+id/tvAdminEventUtilBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_badge_default"
        android:gravity="center"
        android:minWidth="50dp"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:text="0.0%"
        android:textColor="@color/slate_700"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
