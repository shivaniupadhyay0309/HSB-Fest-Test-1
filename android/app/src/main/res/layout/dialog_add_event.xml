<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/slate_200"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Modal Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/brand_600"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add New Fest Event"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnAddEventClose"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/white" />
            </RelativeLayout>

            <!-- Form Body -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvAddEventError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_alert_warning"
                    android:padding="10dp"
                    android:textColor="@color/status_red_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Event Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Event Title *"
                    android:textColor="@color/slate_700"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNewTitle"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/btn_secondary"
                    android:hint="e.g. AI Prompt Battle"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/slate_900"
                    android:textSize="13sp" />

                <!-- Category & Icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Category *"
                            android:textColor="@color/slate_700"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spNewCategory"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/btn_secondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Icon (Emoji)"
                            android:textColor="@color/slate_700"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etNewIcon"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/btn_secondary"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="⚡"
                            android:textColor="@color/slate_900"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Date & Time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Date (YYYY-MM-DD) *"
                            android:textColor="@color/slate_700"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etNewDate"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/btn_secondary"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="2026-11-14"
                            android:textColor="@color/slate_900"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Time *"
                            android:textColor="@color/slate_700"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etNewTime"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/btn_secondary"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="10:00 AM"
                            android:textColor="@color/slate_900"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Venue -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Venue *"
                    android:textColor="@color/slate_700"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNewVenue"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/btn_secondary"
                    android:hint="e.g. Auditorium Hall C"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/slate_900"
                    android:textSize="13sp" />

                <!-- Capacity & Fee -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Capacity (>0) *"
                            android:textColor="@color/slate_700"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etNewCapacity"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/btn_secondary"
                            android:inputType="number"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="50"
                            android:textColor="@color/slate_900"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fee (₹)"
                            android:textColor="@color/slate_700"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etNewFee"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/btn_secondary"
                            android:inputType="number"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="0"
                            android:textColor="@color/slate_900"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Description -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Description"
                    android:textColor="@color/slate_700"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNewDescription"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/btn_secondary"
                    android:gravity="top"
                    android:hint="Brief event description..."
                    android:padding="10dp"
                    android:textColor="@color/slate_900"
                    android:textSize="13sp" />

                <!-- Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelAddEvent"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="Cancel"
                        android:textColor="@color/slate_600" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubmitAddEvent"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:text="Create Event"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/brand_600"
                        app:cornerRadius="10dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.core.widget.NestedScrollView>
