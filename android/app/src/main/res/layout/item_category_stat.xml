<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/bg_stat_card"
    android:backgroundTint="@color/slate_50"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvCatStatName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Technical"
        android:textColor="@color/slate_500"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCatStatCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif-black"
        android:text="3"
        android:textColor="@color/slate_900"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="events"
        android:textColor="@color/slate_400"
        android:textSize="10sp" />

</LinearLayout>
